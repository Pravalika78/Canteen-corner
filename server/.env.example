# Canteen Corner — Copy this file to `.env` and fill in your own values

# REQUIRED

# MongoDB connection string (free at https://cloud.mongodb.com)
# Example:
# mongodb+srv://myuser:mypassword123@cluster0.ab1cd.mongodb.net/food_zone?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/food_zone?retryWrites=true&w=majority

# JWT Secret — any random long string (used to sign login tokens)
# Example: mySecretKey_2025_x89jfksl
JWT_SECRET=change_this_to_any_random_long_string

# Admin Secret Code — any word YOU choose (used for admin signup/login)
# Example: MyCanteen@24  or  year987
ADMIN_SECRET=choose_your_own_admin_secret

# OPTIONAL

# Server port (default 5000 — leave as 5000 unless it's already in use)
PORT=5000

# Gmail for password reset emails (optional — skip if you don't want email)
# Get an App Password: https://myaccount.google.com/apppasswords
# Example: myemail@gmail.com  /  abcd efgh ijkl mnop
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Frontend URL (used in reset-password links)
FRONTEND_URL=http://localhost:3000